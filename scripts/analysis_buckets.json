{
  "_comment": "Comparison battery for analyze_evals.py --config. Paths use ${OUT} (expanded from the environment at run time) so nothing machine-specific is committed — set your output root first, e.g. `export OUT=<your output root>`, where the 0.6B/8B logs live under ${OUT}/logs and the 1.7B/32B logs under ${OUT}/Qwen32B-Qwen1.7B/logs. Each bucket = one focused question, run into <--out>/<name>/. Primary question is always 'does this family beat plain flat-JSD' (baseline default matches jsd_mathhard_s123 / jsd_math_hard_s123 on both boxes). Secondary within-family buckets override baseline_regex. A bucket whose files don't exist yet is skipped with a warning (safe to pre-wire). PENDING EVAL as of 2026-07-06: jsd_dw_lin_naive_K3_math_hard_s123 (1.7/32), enrich_draftcond_K3_mathhard_s123 (1.7/32), lk_alpha_mathhard_s123 (0.6/8). Run: OUT=<your root> python scripts/analyze_evals.py --config scripts/analysis_buckets.json --out ${OUT}/analysis",
  "defaults": {
    "metric": "block_eff",
    "noise": 0.15,
    "baseline_regex": "^jsd_math_?hard_s\\d+$",
    "prefer_attn": "sdpa"
  },
  "buckets": [
    {
      "name": "1p7_32__treelog_vs_jsd",
      "glob": [
        "${OUT}/Qwen32B-Qwen1.7B/logs/jsd_math_hard_s123.csv",
        "${OUT}/Qwen32B-Qwen1.7B/logs/traversal_log_*.csv",
        "${OUT}/Qwen32B-Qwen1.7B/logs/nss_log_*.csv"
      ]
    },
    {
      "name": "1p7_32__enrich_vs_jsd",
      "glob": [
        "${OUT}/Qwen32B-Qwen1.7B/logs/jsd_math_hard_s123.csv",
        "${OUT}/Qwen32B-Qwen1.7B/logs/enrich_K3_math_hard_s123.csv",
        "${OUT}/Qwen32B-Qwen1.7B/logs/enrich_draftcond_K3_mathhard_s123.csv"
      ]
    },
    {
      "name": "1p7_32__depthweight_vs_jsd",
      "glob": [
        "${OUT}/Qwen32B-Qwen1.7B/logs/jsd_math_hard_s123.csv",
        "${OUT}/Qwen32B-Qwen1.7B/logs/jsd_dw_lin_naive_K3_math_hard_s123.csv"
      ]
    },
    {
      "name": "1p7_32__po_cold_vs_jsd",
      "glob": [
        "${OUT}/Qwen32B-Qwen1.7B/logs/jsd_math_hard_s123.csv",
        "${OUT}/Qwen32B-Qwen1.7B/logs/po_logprob_multiN4_L8_math_hard_s123.csv",
        "${OUT}/Qwen32B-Qwen1.7B/logs/po_nss_multiN4_L8_math_hard_s123.csv",
        "${OUT}/Qwen32B-Qwen1.7B/logs/po_traversal_multiN4_L8_math_hard_s123.csv"
      ]
    },
    {
      "name": "1p7_32__po_cold_which_objective",
      "glob": [
        "${OUT}/Qwen32B-Qwen1.7B/logs/po_logprob_multiN4_L8_math_hard_s123.csv",
        "${OUT}/Qwen32B-Qwen1.7B/logs/po_nss_multiN4_L8_math_hard_s123.csv",
        "${OUT}/Qwen32B-Qwen1.7B/logs/po_traversal_multiN4_L8_math_hard_s123.csv"
      ],
      "baseline_regex": "^po_logprob_"
    },
    {
      "name": "0p6_8__enrich_vs_jsd",
      "glob": [
        "${OUT}/logs/jsd_mathhard_s123.csv",
        "${OUT}/logs/jsd_flat_enrich_*.csv"
      ]
    },
    {
      "name": "0p6_8__lk_alpha_vs_jsd",
      "glob": [
        "${OUT}/logs/jsd_mathhard_s123.csv",
        "${OUT}/logs/lk_alpha_mathhard_s123.csv"
      ]
    },
    {
      "name": "0p6_8__po_warm_vs_jsd",
      "glob": [
        "${OUT}/logs/jsd_mathhard_s123.csv",
        "${OUT}/logs/po_mh_logprob_warm_lr1e5.csv",
        "${OUT}/logs/po_traversal_warmjsd_multiN4_L8_lr1e5_math_hard_s123.csv",
        "${OUT}/logs/po_nss_warmjsd_multiN4_L8_lr1e5_s123.csv"
      ]
    },
    {
      "name": "0p6_8__po_warm_which_objective",
      "glob": [
        "${OUT}/logs/po_mh_logprob_warm_lr1e5.csv",
        "${OUT}/logs/po_traversal_warmjsd_multiN4_L8_lr1e5_math_hard_s123.csv",
        "${OUT}/logs/po_nss_warmjsd_multiN4_L8_lr1e5_s123.csv"
      ],
      "baseline_regex": "logprob.*(warm|_lr1e5)"
    }
  ]
}
