#!/usr/bin/env python
"""
pre-commit hook — run unit tests before every git commit.

Blocks the commit if any test fails.  Automatically skips if the test
suite itself is not yet installed (first-time setup with no pytest).

To bypass in an emergency (NOT recommended):
    git commit --no-verify -m "message"

To install on a new machine:
    Copy this file to .git/hooks/pre-commit and make it executable:
        chmod +x .git/hooks/pre-commit   # Linux/macOS
        # Windows: Git for Windows runs Python hooks natively
"""

import subprocess
import sys
import os

_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))  # 2026 summer/
_GBV_ROOT  = os.path.join(_REPO_ROOT, "gbv-research")
_TEST_DIR  = os.path.join(_GBV_ROOT, "tests", "unit")

# Only run tests if the test suite exists
if not os.path.isdir(_TEST_DIR):
    sys.exit(0)

# Check that pytest is available
try:
    subprocess.run(
        [sys.executable, "-m", "pytest", "--version"],
        check=True, capture_output=True
    )
except (subprocess.CalledProcessError, FileNotFoundError):
    print("[pre-commit] pytest not found — skipping unit tests.")
    print("[pre-commit] Install with: pip install pytest")
    sys.exit(0)

print("[pre-commit] Running unit tests (gbv-research/tests/unit/)...")
print("[pre-commit] To skip in an emergency: git commit --no-verify")
print()

result = subprocess.run(
    [
        sys.executable, "-m", "pytest",
        _TEST_DIR,
        "--tb=short",
        "-q",
        "--no-header",
        "--rootdir", _GBV_ROOT,
        "--override-ini=testpaths=",
    ],
    cwd=_GBV_ROOT,
)

if result.returncode != 0:
    print()
    print("[pre-commit] UNIT TESTS FAILED — commit blocked.")
    print("[pre-commit] Fix the failing tests before committing.")
    print("[pre-commit] Run manually:  python gbv-research/tests/run_unit_tests.py")
    sys.exit(1)

print("[pre-commit] All unit tests passed.")
sys.exit(0)
