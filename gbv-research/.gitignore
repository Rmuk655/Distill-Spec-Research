# ── Generated outputs (db/) ────────────────────────────────────────────────────
# All run artifacts live under db/.  Only the directory skeleton is tracked.
db/checkpoints/
db/wandb/
db/results.db
db/logs/
db/pipeline_state*.json

# ── Orchestration runtime files (not experiment data) ─────────────────────────
orchestration/.pipeline_lock
orchestration/pipeline_state_*.json   # runtime state — gitignored (git rm --cached applied)
orchestration/wandb/                  # stale WandB runs from before db/wandb/ migration
orchestration/*_crashed.log           # crash-session copies of logs (archived by pipeline)
orchestration/pipeline_step_*_error.log  # per-step error logs captured by pipeline
# Note: pipeline_output.log and be_progress.log now live in db/logs/ (above)

# ── Large model weight files (anywhere in the tree) ───────────────────────────
*.safetensors
*.bin
*.pt
*.pth

# ── Datasets: large training corpora, small eval sets are kept ────────────────
# Ignore everything under raw/ by default …
core/datasets/raw/*.jsonl
core/datasets/raw/.cache/

# … then un-ignore the small curated eval/seed sets that ARE tracked
!core/datasets/raw/gsm8k_5.jsonl
!core/datasets/raw/gsm8k_10.jsonl
!core/datasets/raw/gsm8k_30.jsonl
!core/datasets/raw/diverse50.jsonl
!core/datasets/raw/math500_30.jsonl
!core/datasets/raw/mtbench_80.jsonl
!core/datasets/raw/humaneval.jsonl

# ── Python runtime ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.eggs/
*.egg-info/
dist/
build/

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── HuggingFace cache (guard against local copies outside ~/.cache) ────────────
.cache/
hub/

# ── Paper artefacts: generated figures and tables (re-generated by scripts) ───
paper/figures/*.pdf
paper/figures/*.png
paper/tables/*.tex
paper/tables/*.csv

# ── OS / IDE noise ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ── Secrets / credentials ──────────────────────────────────────────────────────
.env
*.key
wandb_api_key*
secrets.yaml
# Per-user WandB config (copy from wandb_config.json.example, never commit)
orchestration/wandb_config.json
